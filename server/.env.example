# Copy this file to `.env` and fill in your local values.
# The real `.env` is gitignored.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lau_library
# Set DB_SSL=true when connecting to a managed cloud DB (Railway, PlanetScale, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ---
# Generate secrets with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-32-character-secret

# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:5000
ALLOW_DEMO_SEED=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
